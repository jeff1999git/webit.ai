# ─────────────────────────────────────────────
# Environment variables — copy to .env.local for local development and set
# the same names in Vercel (Project → Settings → Environment Variables).
# Never commit real values.
# ─────────────────────────────────────────────

# Required for enquiry delivery. Resend API key used by /api/contact.
# Create one at https://resend.com/api-keys. Without it the enquiry form
# shows a friendly "please email us instead" error.
RESEND_API_KEY=

# Optional. Inbox that receives enquiries. Defaults to the fallback address
# in app/api/contact/route.ts. While the sender is Resend's shared
# onboarding@resend.dev address, Resend only delivers to the email address
# of the Resend account owner.
CONTACT_TO_EMAIL=

# Optional. Sender for enquiry emails. Must use a domain verified in Resend,
# e.g. "Webitai Labs <hello@yourdomain.com>". Defaults to
# "Webitai Labs <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=

# Optional. Public base URL used for canonical links, the sitemap, robots.txt
# and social previews. No trailing slash needed. Defaults to
# https://webitai.vercel.app
NEXT_PUBLIC_SITE_URL=
